target/
.DS_Store

# What a release build leaves behind, if one is run by hand.
dist/
npm-dist/
opscope-*.tar.gz
opscope-*.tar.gz.sha256
CHANGELOG-release.md

# Personal settings, and now secrets: config.json holds the Vercel token.
# Variants are covered too, so a config.local.json or a stray .env cannot be
# committed by accident.
config.json
config.*.json
# And anything derived from it. `config.*.json` does not cover
# `config.json.bak-20260825-120228`, which is the shape an editor or a
# careless `cp` actually leaves behind - the name ends in the timestamp,
# not in .json. Two such files were sitting untracked in this checkout,
# holding live tokens, one `git add -A` away from a public commit.
config.json.*
!config.example.json
.env
.env.*
*.token
*.secret
